# Битрикс24 — локальное приложение (как на Railway)
BITRIX24_CLIENT_ID=local.xxxxxxxxxxxx.xxxxxxxx
BITRIX24_CLIENT_SECRET=your_client_secret
BITRIX24_HANDLER_URL=https://your-app.timeweb.cloud/webhook/bitrix24
# Для исходящего webhook — обязателен (чтение лидов). Для локального приложения — запасной вариант.
BITRIX_INCOMING_WEBHOOK_URL=https://yourcompany.bitrix24.ru/rest/1/xxxxx/
# Application token из исходящего webhook (если используете его вместо локального приложения)
BITRIX24_APPLICATION_TOKEN=

# Mango Office — обратный звонок (опционально)
MANGO_CALL_URL_TEMPLATE=https://integration-webhook.mango-office.ru/webhookapp/common?code=CODE&Source=Other&API_key=API_KEY&Action=Callback&EmployeeNUM=EMPLOYEE&TelNumbr={phone}

# Поля лида CRM (коды UF)
BITRIX_FIELD_CITY=UF_CRM_CITY
BITRIX_FIELD_VISA_QUESTIONS=UF_CRM_VISA_QUESTIONS

# MAX Bot API
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=your_max_bot_token
MAX_WEBHOOK_SECRET=your_webhook_secret_min_5_chars
MAX_SUBSCRIBE_CODE=482917
# Авторегистрация webhook MAX при старте (true/false)
MAX_AUTO_REGISTER_WEBHOOK=true
# На Timeweb Docker иногда нужно отключить SSL-проверку для MAX API:
HTTP_SSL_VERIFY=false
# Публичный URL приложения (если не выводится из BITRIX24_HANDLER_URL)
PUBLIC_APP_URL=https://your-app.timeweb.cloud

DATA_DIR=/tmp/sale_b24_data
WEBHOOK_PATH_SECRET=
